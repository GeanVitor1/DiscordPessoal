{
  "name": "discord-clone",
  "version": "1.0.16",
  "description": "Aplicativo de ComunicaÃ§Ã£o em Tempo Real",
  "author": "MeuApp Team",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "npm run start --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "node start-all.js",
    "dev:lan": "node start-all.js",
    "dev:https": "cross-env VITE_USE_HTTPS=true node start-all.js",
    "desktop": "cross-env VITE_USE_HTTPS=false VITE_DEV_SERVER_URL=http://localhost:5173 concurrently -k -s first \"npm run dev\" \"wait-on http://localhost:5173 && electron desktop/main.js\"",
    "build:client": "npm run build --prefix client",
    "test": "npm test --prefix client && node --test tests/*.test.js",
    "test:rtc": "node scripts/run-electron-test.js tests/rtc-electron.js",
    "test:ui": "node scripts/run-electron-test.js tests/ui-electron.js",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "build:desktop": "node scripts/validate-production-build.js && npm test && npm run build:native && npm run build:client && npm run test:desktop && electron-builder --win --publish never && node scripts/verify-package.js",
    "build:desktop:dev": "npm run build:native && npm run build:client && electron-builder --win --publish never",
    "certs:gen": "node scripts/generate-certs.js",
    "release": "node scripts/release.js",
    "start": "node start-all.js",
    "test:native": "node scripts/run-electron-test.js tests/native-electron.js",
    "test:packaged:two-clients": "node tests/desktop-two-client.js",
    "test:desktop": "npm run test:rtc && npm run test:ui && npm run test:native && node scripts/run-electron-test.js tests/desktop-smoke.js"
  },
  "main": "desktop/main.js",
  "build": {
    "appId": "com.meuapp.comunicacao",
    "productName": "MeuApp",
    "publish": [
      {
        "provider": "github",
        "owner": "GeanVitor1",
        "repo": "DiscordPessoal"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "client/dist/**/*"
    ],
    "asarUnpack": [
      "desktop/NativeInputHost.exe"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "MeuApp-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MeuApp"
    }
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.2"
  }
}
