# ==============================================================================
# Modelo de Variáveis de Ambiente para Produção (.env.production)
# NUNCA commite o arquivo .env.production com credenciais reais no repositório!
# No servidor VPS, copie este arquivo: cp .env.production.example .env.production
# e preencha com credenciais seguras e geradas aleatoriamente.
# ==============================================================================

# --- Domínio Público da Aplicação ---
# O Caddy gerará e renovará certificados Let's Encrypt automaticamente para este domínio.
# Exemplo: api.meudominio.com
CADDY_DOMAIN=

# --- Banco de Dados PostgreSQL Central ---
POSTGRES_DB=meuapp_db
POSTGRES_USER=meuapp_user
# Gere uma senha segura com: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Servidor TURN / STUN (coturn) ---
# Domínio ou IP público onde o coturn estará escutando (ex: turn.meudominio.com ou IP da VPS)
TURN_SERVER_HOST=
TURN_EXTERNAL_IP=
TURN_PORT=3478
TURN_REALM=meuapp.com
# Segredo compartilhado estritamente entre o Backend e o coturn para gerar tokens temporários HMAC.
# Gere com: openssl rand -hex 32
TURN_SECRET=

# --- E-mail de confirmação e recuperação (SMTP) ---
# Deixe SMTP_HOST e MAIL_FROM vazios enquanto não houver provedor.
# 587 usa STARTTLS obrigatório; 465 usa TLS desde a conexão.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Origem HTTPS do site para abrir os links recebidos.
PUBLIC_APP_URL=
